generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- Auth (Better Auth) ---

// Newsroom roles. ADMIN has full access; EDITOR can write and publish
// anyone's work but can't touch site-level settings/users; AUTHOR can only
// create and edit their OWN articles and can't publish (they submit for
// review instead). USER is a plain reader with no admin access at all —
// it stays the default so public registration can't mint staff.
// See app/lib/permissions.ts for the single source of truth on what each
// role may actually do.
enum Role {
  ADMIN
  EDITOR
  AUTHOR
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          Role      @default(USER)
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Reading-streak tracking (see lib/streaks.ts) — lastActiveDate is
  // compared by calendar day (UTC), not a precise timestamp, so a visit
  // any time on consecutive days counts; currentStreak resets to 1 on a
  // gap rather than going to 0, since the visit that resets it IS day 1
  // of a new streak.
  currentStreak  Int       @default(0) @map("current_streak")
  lastActiveDate DateTime? @map("last_active_date")

  sessions          Session[]
  accounts          Account[]
  articles          Article[]
  likes             Like[]
  comments          Comment[]
  savedArticles     SavedArticle[]
  categoryInterests CategoryInterest[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// --- Content ---

// The editorial pipeline. SCHEDULED is deliberately NOT a stored status —
// it's derived (PUBLISHED + a future publishedAt), so an article going
// live is a clock tick rather than a job that has to run and can fail.
// IN_REVIEW is what an AUTHOR submits to; ARCHIVED retires a story from
// the public site without deleting it.
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

enum NavPlacement {
  MAIN
  MORE
  HIDDEN

  @@map("nav_placement")
}

// One row per article per UTC day, not per pageview. Article.viewCount is a
// lifetime counter with no date attached, so nothing could answer "how did
// this story do this week" — the dashboard had to render an all-time figure
// and say so. This keeps that counter (it's what the articles list sorts on)
// and adds the time series beside it, at one row per story per day rather
// than a row per hit.
model ArticleView {
  id        String   @id @default(cuid())
  articleId Int      @map("article_id")
  // Date only — the unique constraint below is what makes the upsert
  // collapse a day's hits into a single row.
  day       DateTime @db.Date
  count     Int      @default(1)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, day])
  @@index([day])
  @@map("article_views")
}

// A message from a visitor: either a general contact-form message or a pitch
// asking for a show to be added to the site.
//
// One model with a `kind` rather than two: both are "someone wrote in, an
// editor reads it and decides", the admin inbox is the same list either way,
// and the only real difference is a handful of podcast fields that are simply
// null on a general message. Splitting them would have meant two screens and
// two pipelines for one workflow.
enum SubmissionKind {
  GENERAL
  PODCAST
  // Paid feature-article enquiries from /feature-article. Its own kind so
  // the Inbox can be filtered to sales enquiries rather than mixing them
  // in with tips and corrections.
  FEATURE_ARTICLE
}

enum SubmissionStatus {
  NEW
  REVIEWING
  APPROVED
  DECLINED
  ARCHIVED
}

model Submission {
  id     String           @id @default(cuid())
  kind   SubmissionKind   @default(GENERAL)
  status SubmissionStatus @default(NEW)

  name    String
  email   String
  // Free text: a phone number, a social handle, whatever they prefer.
  contact String?
  subject String?
  message String

  // Podcast pitches only.
  showName String? @map("show_name")
  feedUrl  String? @map("feed_url")

  // Set once a podcast pitch has actually been turned into a live show, so
  // the same feed can't be imported twice from the same pitch.
  importedPodcastId String? @map("imported_podcast_id")

  // Editor-only, never shown to the sender.
  adminNotes String? @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("submissions")
}

// An author profile. Deliberately keyed off the article's existing plain
// `author` text column (matched on a slug of the name) rather than replacing
// it with a foreign key: every one of the imported articles already carries a
// byline string, and a hard relation would have meant a migration that either
// dropped those bylines or invented author rows for them. This way an author
// page exists for every byline immediately, and filling in a profile enriches
// it rather than being a precondition for it.
model Author {
  id          String  @id @default(cuid())
  // Slug of the byline as it appears on articles, e.g. "rocci-stucci".
  slug        String  @unique
  name        String
  title       String?
  bio         String?
  avatarUrl   String? @map("avatar_url")
  // Only ever profiles that genuinely belong to this author — an empty
  // field renders nothing rather than a dead link.
  websiteUrl  String? @map("website_url")
  twitterUrl  String? @map("twitter_url")
  facebookUrl String? @map("facebook_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("authors")
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  color       String?

  // Nav placement/order — the site's SiteHeader/MobileMenu/SiteFooter nav
  // reads directly from these instead of a hand-maintained hardcoded
  // list, so adding a category no longer risks the nav silently drifting
  // out of sync with the category list. MAIN renders directly in the top
  // bar (capped at a handful of items — see getMainNavCategories()'s
  // comment), MORE sits in the "More" dropdown/mobile section, HIDDEN
  // stays out of the nav entirely. navOrder is only meaningful relative
  // to other categories in the same placement.
  navPlacement NavPlacement @default(MAIN) @map("nav_placement")
  navOrder     Int          @default(0) @map("nav_order")

  // Social-share image for the category page itself (og:image) — separate
  // from any article's own share image.
  shareImage String? @map("share_image")

  createdAt DateTime @default(now()) @map("created_at")

  articles ArticleCategory[]

  @@map("categories")
}

model Article {
  id   Int    @id @default(autoincrement())
  slug String @unique

  // Legacy primary-category slug, kept for the existing site UI (nav rails,
  // category pages) which reads a single category per article. Additional
  // categories can be attached via ArticleCategory without touching this.
  categorySlug String @map("category_slug")

  headline String
  dek      String
  author   String @default("Rocci Stucci")
  body     String

  // Free-form hashtag-style tags, editorial-only (not a taxonomy table —
  // categories already own that job). Native Postgres text[], no join
  // table needed for something this lightweight.
  tags String[] @default([])

  coverImageUrl String? @map("cover_image_url")

  // "Bottom Line Up Front" — a short, punchy 2-4 bullet "why it matters"
  // list an editor can set per article, shown above the body on the
  // public article page. Empty means no box renders; not auto-generated
  // from body content.
  bulletPoints String[] @default([]) @map("bullet_points")

  // "What They're Not Telling You" — an optional callout contrasting how
  // mainstream coverage is framing a story against this article's angle,
  // with a link to the coverage being referenced. All four fields are
  // independent; the box only renders when title+body are both set.
  comparisonTitle       String? @map("comparison_title")
  comparisonBody        String? @map("comparison_body")
  comparisonSourceLabel String? @map("comparison_source_label")
  comparisonSourceUrl   String? @map("comparison_source_url")

  // Editorial "this is original reporting" flag — distinct from isFeatured
  // (a curation choice for the homepage), this marks the story itself as
  // an exclusive/scoop regardless of whether it's currently featured.
  isExclusive Boolean @default(false) @map("is_exclusive")

  // Live blog format — when true, the public article page renders a
  // reverse-chronological LiveBlogEntry timeline (see lib/live-blog.ts)
  // instead of/above the normal static body, with a pulsing "LIVE" badge.
  // The article's own `body` field still exists underneath (e.g. as an
  // intro/context blurb) — this is additive, not a replacement content
  // model, so turning the flag off doesn't lose anything.
  isLiveBlog Boolean @default(false) @map("is_live_blog")

  status     ArticleStatus @default(DRAFT)
  isFeatured Boolean       @default(false) @map("is_featured")
  viewCount  Int           @default(0) @map("view_count")

  // Breaking-news flag — drives the site's BreakingBar ticker. Distinct
  // from isFeatured (homepage curation) and isExclusive (original
  // reporting): a story can be breaking without being either.
  isBreaking Boolean @default(false) @map("is_breaking")

  // Soft delete. Every admin and public read filters on `deletedAt: null`;
  // a "deleted" article moves to /admin/trash where it can be restored or
  // purged for real. Nothing in the CMS hard-deletes an article on the
  // first click any more.
  deletedAt DateTime? @map("deleted_at")

  // Free-form notes for whoever posts this to social — not rendered
  // anywhere public, just a scratchpad that travels with the article.
  socialNotes String? @map("social_notes")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords    String? @map("seo_keywords")
  ogImage        String? @map("og_image")
  canonicalUrl   String? @map("canonical_url")

  authorId   String? @map("author_id")
  authorUser User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  categories      ArticleCategory[]
  likes           Like[]
  comments        Comment[]
  savedBy         SavedArticle[]
  liveBlogEntries LiveBlogEntry[]
  revisions       ArticleRevision[]
  views           ArticleView[]
  pageViews       PageView[]

  @@index([categorySlug], map: "articles_category_slug_idx")
  @@index([status, publishedAt(sort: Desc)], map: "articles_status_published_at_idx")
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("articles")
}

// A point-in-time snapshot of an article's editable content, written on
// every save (see lib/revisions.ts). Deliberately a full snapshot rather
// than a stored diff — diffs are computed on read for the history viewer,
// which keeps writes trivial and means a corrupted/missing intermediate
// revision can never make later ones unreadable. Author identity is
// snapshotted by name/email for the same reason ActivityLog does it: the
// history still reads correctly after an account is renamed or removed.
model ArticleRevision {
  id        String @id @default(cuid())
  articleId Int    @map("article_id")

  headline String
  dek      String
  body     String

  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")
  // "Autosave" vs. an explicit save — the history viewer collapses runs of
  // autosaves so a day of writing doesn't bury the meaningful checkpoints.
  isAutosave  Boolean @default(false) @map("is_autosave")
  note        String?

  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt(sort: Desc)])
  @@map("article_revisions")
}

model ArticleCategory {
  articleId  Int    @map("article_id")
  categoryId String @map("category_id")

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
  @@map("article_categories")
}

model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId Int      @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@map("likes")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  articleId  Int      @map("article_id")
  userId     String   @map("user_id")
  parentId   String?  @map("parent_id")
  isApproved Boolean  @default(false) @map("is_approved")
  // Admin-curated "Editor's Pick" — pinned top-level comments sort first
  // on the article page (see getApprovedCommentsForArticle). Independent
  // of isApproved; a pin doesn't bypass moderation.
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([articleId, isApproved])
  @@index([parentId])
  @@map("comments")
}

// Tracks how many times a reader has viewed an article in each category —
// incremented fire-and-forget on every article view (see lib/streaks.ts's
// sibling function in lib/interests.ts), read back to build the homepage's
// personalized "Recommended For You" rail. Deliberately not a full
// per-article reading-history log — a per-category counter is all the
// personalization rail needs and is far cheaper to query.
model CategoryInterest {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  categorySlug String   @map("category_slug")
  count        Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug])
  @@index([userId])
  @@map("category_interests")
}

// A reader's private "read later" list — same shape as Like, kept as its
// own model rather than reusing Like with a type flag, since the two
// mean different things and a UI change to one shouldn't risk the other.
model SavedArticle {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId Int      @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_articles")
}

// Individual timestamped updates within a live-blog-format Article (see
// Article.isLiveBlog). Deliberately its own append-only table rather than
// reusing Comment or stuffing entries into `body` — an entry needs its own
// timestamp shown to readers and independent create/delete, and unlike a
// comment it's editor-authored, not reader-submitted.
model LiveBlogEntry {
  id        String   @id @default(cuid())
  articleId Int      @map("article_id")
  headline  String?
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt(sort: Desc)])
  @@map("live_blog_entries")
}

// Browser Push API subscriptions (see lib/push.ts) — endpoint/p256dh/auth
// are exactly the fields the Push API's PushSubscription object provides,
// stored verbatim so web-push can target them later. userId is optional:
// a signed-out visitor can still opt into "Breaking News Alerts" for the
// browser they're on, same as most news sites' push prompts don't require
// an account. Deleting a User cascades their subscription rows, but an
// anonymous subscription has no user to cascade from and is only ever
// cleaned up when the endpoint itself goes stale (a failed send).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Subscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  // Which capture point earned this signup (footer strip, sidebar, the
  // modal, an article, the subscribe page). Nullable because every row
  // that existed before this column did genuinely has no answer, and
  // backfilling a guess would be worse than an honest blank.
  source String?

  @@map("subscribers")
}

// Lightweight admin audit trail — who did what, when. actorName/actorEmail
// are snapshotted at write time (not just a relation to User) so the log
// still reads sensibly if an admin account is later deleted or renamed.
model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String?  @map("actor_id")
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetLabel String   @map("target_label")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// --- Promotional banners ---

// The site's 3 fixed placement slots (homepage mid-content, mid-article,
// near the top of category pages) — deliberately a closed enum, not a
// free-text field, so the public site's slot components can each query
// exactly the placement they render without an admin being able to invent
// a slot nothing on the frontend actually shows.
enum BannerPlacement {
  HOMEPAGE
  ARTICLE
  CATEGORY

  @@map("banner_placement")
}

model Banner {
  id             String          @id @default(cuid())
  name           String?
  imageUrl       String          @map("image_url")
  destinationUrl String          @map("destination_url")
  placement      BannerPlacement
  isActive       Boolean         @default(true) @map("is_active")

  // Both optional — a banner with neither is simply always eligible
  // (subject to isActive) whenever it's live long-term; either bound can
  // be set independently for a scheduled start, an open-ended campaign
  // that just needs to stop on a known date, etc.
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Lower sorts first. Only meaningful relative to other banners in the
  // same placement — no need to keep values globally unique.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

// --- Media library ---

// A lightweight index of every image uploaded through the admin (article
// cover/OG images, category share images, banner images) — recorded
// client-side right after a successful Vercel Blob upload (see
// ImageField.tsx), not via Blob's webhook, since that webhook only fires
// in a real deployed environment, never against a local dev server.
// Deleting a row here also deletes the underlying Blob object (via
// @vercel/blob's del()) — this is a library of the actual files, not just
// a list of URLs some other row happens to reference.
model MediaAsset {
  id              String   @id @default(cuid())
  url             String   @unique
  filename        String
  uploadedByName  String   @map("uploaded_by_name")
  uploadedByEmail String   @map("uploaded_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  // Default alt text, reused whenever this asset is inserted into an
  // article body so accessibility isn't re-litigated at every insertion.
  alt String?

  // Intrinsic dimensions + weight, captured client-side at upload time
  // (the browser already decoded the image to compress it, so this is
  // free) — powers the library's "next/image ready" sizing hints.
  width     Int?
  height    Int?
  sizeBytes Int?    @map("size_bytes")
  mimeType  String? @map("mime_type")

  // Lightweight organization. A null folder means "unfiled" rather than a
  // magic root row, so deleting a folder can simply null this out instead
  // of cascading away the actual files.
  folderId String?      @map("folder_id")
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags String[] @default([])

  @@index([createdAt(sort: Desc)])
  @@index([folderId])
  @@map("media_assets")
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  assets MediaAsset[]

  @@map("media_folders")
}

// --- Podcast ---

// --- Syndicated podcasts (RSS) ---

// A show mirrored from an external RSS feed. Distinct from PodcastEpisode
// below, which is a hand-authored episode of Rocci's own show with show
// notes written in the admin's rich editor. This side is a *mirror*: every
// field is owned by the upstream feed and is overwritten on each refresh,
// so nothing here is editable in the admin beyond the handful of
// presentation fields marked below.
model Podcast {
  id      String @id @default(cuid())
  slug    String @unique
  feedUrl String @unique @map("feed_url")

  // Everything from here to `language` is populated from the feed and
  // replaced wholesale on refresh.
  title         String
  description   String   @default("")
  coverImageUrl String?  @map("cover_image_url")
  author        String?
  websiteUrl    String?  @map("website_url")
  language      String?
  isExplicit    Boolean  @default(false) @map("is_explicit")
  categories    String[] @default([])

  // Editor-owned presentation fields — NOT touched by a feed refresh.
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  // Refresh bookkeeping. lastFetchError holds the most recent failure
  // message so the admin can show *why* a feed went stale rather than
  // just that it did; it's cleared on the next success.
  lastFetchedAt  DateTime? @map("last_fetched_at")
  lastFetchError String?   @map("last_fetch_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  episodes PodcastFeedEpisode[]

  @@index([isActive, sortOrder])
  @@map("podcasts")
}

// One item from a podcast feed. Keyed by the feed's own <guid> within its
// show, so a refresh updates an existing episode in place rather than
// duplicating it — publishers routinely re-title or fix an episode after
// publishing, and a guid-keyed upsert picks that up for free.
model PodcastFeedEpisode {
  id        String @id @default(cuid())
  podcastId String @map("podcast_id")
  guid      String

  // Derived from the title, unique within its show. The feed's own guid is
  // unique but routinely a full URL or a UUID, so it can't be a path
  // segment — this is what /podcasts/<show>/<episode> actually uses.
  slug String

  title           String
  description     String  @default("")
  audioUrl        String? @map("audio_url")
  audioType       String? @map("audio_type")
  durationSeconds Int?    @map("duration_seconds")
  imageUrl        String? @map("image_url")
  episodeUrl      String? @map("episode_url")
  episodeNumber   Int?    @map("episode_number")
  seasonNumber    Int?    @map("season_number")
  isExplicit      Boolean @default(false) @map("is_explicit")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, guid])
  @@unique([podcastId, slug])
  @@index([podcastId, publishedAt(sort: Desc)])
  @@map("podcast_feed_episodes")
}

// RETIRED — no code reads or writes this any more.
//
// The hand-entry episode manager at /admin/podcast was removed once shows
// started coming from their RSS feed; episodes here never had a public page,
// so nothing on the site was lost. The model and its table are kept only so
// that whatever rows exist aren't destroyed by a schema change nobody could
// review — dropping a table is not reversible and the contents of the
// production one can't be inspected from here.
//
// To see what's in it:   SELECT count(*) FROM podcast_episodes;
// To retire it for good: DROP TABLE podcast_episodes;  (then delete this model)
model PodcastEpisode {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  subtitle String?

  // Optional so a season-less show works: episodes are ordered by
  // publishedAt, and the number is display metadata, not a sort key.
  episodeNumber Int? @map("episode_number")
  seasonNumber  Int? @map("season_number")

  // Either an uploaded Blob object or an external host's URL — the field
  // is just a URL, so migrating a back catalogue off another host later
  // needs no schema change.
  audioUrl        String? @map("audio_url")
  durationSeconds Int?    @map("duration_seconds")

  coverImageUrl String? @map("cover_image_url")
  // @map is required here: the migration that created this table writes
  // snake_case like every other column, but these two were declared without
  // it, so Prisma looked for a "showNotes" column that production never had
  // and every query against podcast_episodes failed.
  showNotes     String  @default("") @map("show_notes")
  transcript    String  @default("")

  guestName String? @map("guest_name")
  guestBio  String? @map("guest_bio")

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  deletedAt   DateTime?     @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@map("podcast_episodes")
}

// --- Settings ---

// A flat key/value store rather than a one-row settings table: adding a
// setting needs no migration, and a key that hasn't been set yet simply
// falls back to its code-defined default (see lib/settings.ts), so the
// app never depends on a row existing.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// --- Staff invites ---

// An invite is a pre-authorized role assignment keyed by email. It does
// NOT create the account — the invitee registers normally through the
// public flow and the role is applied on first sign-up (see
// lib/invites.ts), so Better Auth stays the only thing that ever hashes a
// password.
model Invite {
  id         String    @id @default(cuid())
  email      String    @unique
  role       Role
  token      String    @unique
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("invites")
}

// --- Redirects ---

// Simple path -> path redirects for retired/renamed URLs. Resolved at
// request time by the catch-all app/[...path]/page.tsx route (Next.js
// only reaches a catch-all after every real route fails to match, which
// is exactly when a redirect should kick in) rather than in proxy.ts —
// the edge middleware here can't reach Postgres (see AGENTS.md/CLAUDE.md
// on the Neon HTTP-driver constraint), only a normal server component can.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(308) @map("status_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}

// --- Analytics ---

// One row per page view, across the whole public site rather than just
// articles. The pre-existing Article.viewCount / ArticleView pair stays
// exactly as it was (the dashboard and the admin list read it, and it is
// the only history that exists for anything published before this table);
// this is the richer series everything new is built on.
//
// Engagement is filled in on a second write: the page POSTs the view on
// load and gets an id back, then sends duration and scroll depth by
// `navigator.sendBeacon` when the tab is hidden or closed. Both columns
// stay null for a visitor who leaves before that fires, so every average
// over them has to exclude nulls rather than treat them as zero.
//
// Visitors are counted without a cookie: `visitorHash` is a salted hash of
// IP + user agent + the UTC date, so it identifies a person for one day and
// then stops. That keeps unique-visitor counts honest without storing
// anything that follows someone around, and means the site needs no consent
// banner for it. The tradeoff, stated plainly because it shows up in the
// numbers: a visitor who comes back tomorrow counts as new tomorrow.
model PageView {
  id String @id @default(cuid())

  path      String
  pageType  String   @map("page_type")
  articleId Int?     @map("article_id")
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Anonymous, client-generated, sessionStorage-scoped. Groups the pages of
  // one visit together so bounce rate and pages-per-session are computable.
  sessionId   String @map("session_id")
  visitorHash String @map("visitor_hash")

  // Where they came from. `source` is the bucketed form (direct / search /
  // social / referral / internal) that the UI groups by; the raw referrer is
  // kept alongside it so a surprising bucket can always be traced back.
  referrer       String? @db.Text
  referrerDomain String? @map("referrer_domain")
  source         String
  utmSource      String? @map("utm_source")
  utmMedium      String? @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")

  device  String
  browser String
  os      String
  country String?

  // Null until the engagement beacon lands. See the note above.
  durationMs Int? @map("duration_ms")
  scrollPct  Int? @map("scroll_pct")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([articleId, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([visitorHash, createdAt])
  @@index([source, createdAt(sort: Desc)])
  @@map("page_views")
}
