generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- Auth (Better Auth) ---

enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          Role      @default(USER)
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Reading-streak tracking (see lib/streaks.ts) — lastActiveDate is
  // compared by calendar day (UTC), not a precise timestamp, so a visit
  // any time on consecutive days counts; currentStreak resets to 1 on a
  // gap rather than going to 0, since the visit that resets it IS day 1
  // of a new streak.
  currentStreak  Int       @default(0) @map("current_streak")
  lastActiveDate DateTime? @map("last_active_date")

  sessions          Session[]
  accounts          Account[]
  articles          Article[]
  likes             Like[]
  comments          Comment[]
  savedArticles     SavedArticle[]
  categoryInterests CategoryInterest[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  impersonatedBy String? @map("impersonated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// --- Content ---

enum ArticleStatus {
  DRAFT
  PUBLISHED

  @@map("article_status")
}

enum NavPlacement {
  MAIN
  MORE
  HIDDEN

  @@map("nav_placement")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?

  // Nav placement/order — the site's SiteHeader/MobileMenu/SiteFooter nav
  // reads directly from these instead of a hand-maintained hardcoded
  // list, so adding a category no longer risks the nav silently drifting
  // out of sync with the category list. MAIN renders directly in the top
  // bar (capped at a handful of items — see getMainNavCategories()'s
  // comment), MORE sits in the "More" dropdown/mobile section, HIDDEN
  // stays out of the nav entirely. navOrder is only meaningful relative
  // to other categories in the same placement.
  navPlacement NavPlacement @default(MAIN) @map("nav_placement")
  navOrder     Int          @default(0) @map("nav_order")

  // Social-share image for the category page itself (og:image) — separate
  // from any article's own share image.
  shareImage String? @map("share_image")

  createdAt DateTime @default(now()) @map("created_at")

  articles ArticleCategory[]

  @@map("categories")
}

model Article {
  id     Int    @id @default(autoincrement())
  slug   String @unique

  // Legacy primary-category slug, kept for the existing site UI (nav rails,
  // category pages) which reads a single category per article. Additional
  // categories can be attached via ArticleCategory without touching this.
  categorySlug String @map("category_slug")

  headline String
  dek      String
  author   String @default("Rocci Stucci")
  body     String

  // Free-form hashtag-style tags, editorial-only (not a taxonomy table —
  // categories already own that job). Native Postgres text[], no join
  // table needed for something this lightweight.
  tags String[] @default([])

  coverImageUrl String? @map("cover_image_url")

  // "Bottom Line Up Front" — a short, punchy 2-4 bullet "why it matters"
  // list an editor can set per article, shown above the body on the
  // public article page. Empty means no box renders; not auto-generated
  // from body content.
  bulletPoints String[] @default([]) @map("bullet_points")

  // "What They're Not Telling You" — an optional callout contrasting how
  // mainstream coverage is framing a story against this article's angle,
  // with a link to the coverage being referenced. All four fields are
  // independent; the box only renders when title+body are both set.
  comparisonTitle       String? @map("comparison_title")
  comparisonBody        String? @map("comparison_body")
  comparisonSourceLabel String? @map("comparison_source_label")
  comparisonSourceUrl   String? @map("comparison_source_url")

  // Editorial "this is original reporting" flag — distinct from isFeatured
  // (a curation choice for the homepage), this marks the story itself as
  // an exclusive/scoop regardless of whether it's currently featured.
  isExclusive Boolean @default(false) @map("is_exclusive")

  status      ArticleStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  viewCount   Int           @default(0) @map("view_count")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords    String? @map("seo_keywords")
  ogImage        String? @map("og_image")
  canonicalUrl   String? @map("canonical_url")

  authorId String? @map("author_id")
  authorUser User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  categories    ArticleCategory[]
  likes         Like[]
  comments      Comment[]
  savedBy       SavedArticle[]

  @@index([categorySlug], map: "articles_category_slug_idx")
  @@index([status, publishedAt(sort: Desc)], map: "articles_status_published_at_idx")
  @@index([isFeatured])
  @@map("articles")
}

model ArticleCategory {
  articleId  Int    @map("article_id")
  categoryId String @map("category_id")

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
  @@map("article_categories")
}

model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId Int      @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@map("likes")
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  articleId  Int      @map("article_id")
  userId     String   @map("user_id")
  parentId   String?  @map("parent_id")
  isApproved Boolean  @default(false) @map("is_approved")
  // Admin-curated "Editor's Pick" — pinned top-level comments sort first
  // on the article page (see getApprovedCommentsForArticle). Independent
  // of isApproved; a pin doesn't bypass moderation.
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([articleId, isApproved])
  @@index([parentId])
  @@map("comments")
}

// Tracks how many times a reader has viewed an article in each category —
// incremented fire-and-forget on every article view (see lib/streaks.ts's
// sibling function in lib/interests.ts), read back to build the homepage's
// personalized "Recommended For You" rail. Deliberately not a full
// per-article reading-history log — a per-category counter is all the
// personalization rail needs and is far cheaper to query.
model CategoryInterest {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  categorySlug String   @map("category_slug")
  count        Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug])
  @@index([userId])
  @@map("category_interests")
}

// A reader's private "read later" list — same shape as Like, kept as its
// own model rather than reusing Like with a type flag, since the two
// mean different things and a UI change to one shouldn't risk the other.
model SavedArticle {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId Int      @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_articles")
}

model Subscriber {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  subscribedAt  DateTime @default(now()) @map("subscribed_at")

  @@map("subscribers")
}

// Lightweight admin audit trail — who did what, when. actorName/actorEmail
// are snapshotted at write time (not just a relation to User) so the log
// still reads sensibly if an admin account is later deleted or renamed.
model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String?  @map("actor_id")
  actorName   String   @map("actor_name")
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetLabel String   @map("target_label")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

// --- Promotional banners ---

// The site's 3 fixed placement slots (homepage mid-content, mid-article,
// near the top of category pages) — deliberately a closed enum, not a
// free-text field, so the public site's slot components can each query
// exactly the placement they render without an admin being able to invent
// a slot nothing on the frontend actually shows.
enum BannerPlacement {
  HOMEPAGE
  ARTICLE
  CATEGORY

  @@map("banner_placement")
}

model Banner {
  id             String          @id @default(cuid())
  name           String?
  imageUrl       String          @map("image_url")
  destinationUrl String          @map("destination_url")
  placement      BannerPlacement
  isActive       Boolean         @default(true) @map("is_active")

  // Both optional — a banner with neither is simply always eligible
  // (subject to isActive) whenever it's live long-term; either bound can
  // be set independently for a scheduled start, an open-ended campaign
  // that just needs to stop on a known date, etc.
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Lower sorts first. Only meaningful relative to other banners in the
  // same placement — no need to keep values globally unique.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

// --- Media library ---

// A lightweight index of every image uploaded through the admin (article
// cover/OG images, category share images, banner images) — recorded
// client-side right after a successful Vercel Blob upload (see
// ImageField.tsx), not via Blob's webhook, since that webhook only fires
// in a real deployed environment, never against a local dev server.
// Deleting a row here also deletes the underlying Blob object (via
// @vercel/blob's del()) — this is a library of the actual files, not just
// a list of URLs some other row happens to reference.
model MediaAsset {
  id              String   @id @default(cuid())
  url             String   @unique
  filename        String
  uploadedByName  String   @map("uploaded_by_name")
  uploadedByEmail String   @map("uploaded_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("media_assets")
}

// --- Redirects ---

// Simple path -> path redirects for retired/renamed URLs. Resolved at
// request time by the catch-all app/[...path]/page.tsx route (Next.js
// only reaches a catch-all after every real route fails to match, which
// is exactly when a redirect should kick in) rather than in proxy.ts —
// the edge middleware here can't reach Postgres (see AGENTS.md/CLAUDE.md
// on the Neon HTTP-driver constraint), only a normal server component can.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(308) @map("status_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}
