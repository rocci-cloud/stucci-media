# Neon Postgres — from the Vercel dashboard: Storage tab → Connect Database → Neon.
# `vercel env pull .env.local` fills this in automatically once the integration is added.
DATABASE_URL=

# Vercel Blob — from the Vercel dashboard: Storage tab → Create Database → Blob.
BLOB_READ_WRITE_TOKEN=

# Admin login for /admin. Generate ADMIN_PASSWORD_HASH with:
#   npm run admin:hash-password -- "your-password"
ADMIN_USERNAME=rocci
ADMIN_PASSWORD_HASH=

# Any long random string, used to sign the admin session cookie.
#   openssl rand -base64 32
SESSION_SECRET=
