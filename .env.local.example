# Neon Postgres — from the Vercel dashboard: Storage tab → Connect Database → Neon.
# `vercel env pull .env.local` fills this in (and DATABASE_URL_UNPOOLED) automatically
# once the integration is added.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob — from the Vercel dashboard: Storage tab → Create Database → Blob.
BLOB_READ_WRITE_TOKEN=

# Any long random string — signs Better Auth's session cookies/tokens.
#   openssl rand -base64 32
SESSION_SECRET=

# This app's own URL — Better Auth's baseURL, used for origin checks and
# building callback URLs. http://localhost:3000 in dev.
BETTER_AUTH_URL=
